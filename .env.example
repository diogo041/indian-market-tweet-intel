# X/Twitter session cookies. Create a throwaway account, sign in, then copy
# auth_token and ct0 from DevTools: Application -> Cookies -> https://x.com
#
# Format: label:auth_token:ct0
# Add more accounts as X_ACCOUNT_2, X_ACCOUNT_3, ... The scraper rotates
# between them when one is rate-limited, which is the only way to raise
# throughput past ~50 search requests per 15-minute window.

X_ACCOUNT_1=burner1:PASTE_AUTH_TOKEN_HERE:PASTE_CT0_HERE
